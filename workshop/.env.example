# Container engine: docker or podman. Leave it unset to use Docker when it's installed.
# CONTAINER_ENGINE=podman

# ---------------------------------------------------------------------------
# LLM access
# ---------------------------------------------------------------------------
# mock = use the bundled offline mock LLM (no key, no wifi needed). Every lab works with it.
# live = use the OpenAI-compatible endpoint below. See "LLM options" in README.md.
LLM_MODE=mock
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=sk-from-your-instructor
LLM_MODEL=gpt-4o-mini

# Free and local, on a Mac with Docker Desktop: Ollama (`ollama pull qwen3:1.7b` first)
# LLM_MODE=live
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:1.7b

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# legacy  = AI SDK's legacy telemetry shape (ai.* attributes), what most apps ship today
# semconv = AI SDK's OpenTelemetry GenAI semantic-conventions output
AI_TELEMETRY=legacy
# online = call Open-Meteo / GOV.UK for weather & travel advice, offline = fixtures only
TOOLS_MODE=online
# Fraction of answers graded by the LLM-as-a-judge (1 = every answer). The judge costs tokens too.
EVAL_SAMPLE_RATE=1
# Mock LLM only: fraction of LLM calls that fail with HTTP 429, to practise finding errors.
MOCK_ERROR_RATE=0

# ---------------------------------------------------------------------------
# Elastic Stack (local). You normally don't need to change these.
# ---------------------------------------------------------------------------
STACK_VERSION=9.5.6
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme-kibana
# Where the collector ships telemetry. Point at an instructor cluster if your laptop struggles.
ELASTICSEARCH_ENDPOINT=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# Host ports (change if something on your laptop already uses them; `make doctor` reads these)
ES_PORT=9200
KIBANA_PORT=5601
PROMETHEUS_PORT=9090
APP_PORT=3000
# The collector's host ports. Nothing in the labs needs 4317/4318/8888/8889 on the host;
# change them if you already run a collector locally.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_PROM_PORT=8889
COLLECTOR_METRICS_PORT=8888
COLLECTOR_HEALTH_PORT=13133
